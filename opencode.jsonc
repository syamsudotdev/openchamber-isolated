{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "lsp": true,
  "mcp": {
    "servers": {
      "fff": {
        "type": "local",
        "command": [
          "/usr/local/bin/fff-mcp"
        ]
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp"
      },
      "figma": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "figma-developer-mcp@0.13.2",
          "--stdio"
        ],
        "environment": {
          "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
        }
      }
    }
  },
  "warming": {
    "duration": "30 minutes"
  },
  "experimental": {
    "background_compaction": true
  },
  "websearch": {
    "provider": "random"
  },
  "providers": {
    "alibaba99": {
      "name": "Alibaba 99",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:ALIBABA99_BASE_URL}"
      },
      "models": {
        "deepseek-v4.1-flash-1017": {
          "modelID": "deepseek-v4.1-flash-1017",
          "name": "deepseek-v4.1-flash-1017",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "qwen4-max": {
          "modelID": "qwen4-max",
          "name": "qwen4-max",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 983000,
            "output": 256000
          }
        }
      }
    }
  },
  "plugins": [
    "agent-formal-verify@0.4.12"
  ]
}
