{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "lsp": true,
  "mcp": {
    "servers": {
      "fff": {
        "type": "local",
        "command": [
          "/usr/local/bin/fff-mcp"
        ]
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp"
      },
      "figma": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "figma-developer-mcp@0.13.2",
          "--stdio"
        ],
        "environment": {
          "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
        }
      }
    }
  },
  "warming": {
    "duration": "30 minutes"
  },
  "experimental": {
    "background_compaction": true
  },
  "websearch": {
    "provider": "random"
  }
}
