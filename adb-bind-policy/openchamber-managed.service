[Unit]
Description=OpenChamber Compose with host ADB bind protection
Requires=openchamber-bind-policy.service
After=openchamber-bind-policy.service
BindsTo=openchamber-bind-policy.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=syamsudotdev
Environment=HOME=/home/syamsudotdev
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
WorkingDirectory=/home/syamsudotdev/Projects/openchamber-isolated
ExecStartPre=+/usr/local/libexec/openchamber-bind-policy start
ExecStartPre=/usr/bin/systemctl --user start docker.service
ExecStart=/usr/bin/docker compose -f compose.yaml -f /etc/openchamber-bind-policy/compose.override.yaml up -d --force-recreate opencode
ExecStop=/usr/bin/docker compose -f compose.yaml -f /etc/openchamber-bind-policy/compose.override.yaml stop opencode
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
